# Local-only billing template. Replace Supabase placeholders with local Docker values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Simulator is explicit and only accepted with local Supabase Docker.
COACH_BILLING_MODE=simulator
COACH_BILLING_LOCAL_SIMULATOR=true

# Set these only for ONVO test mode. Never use live credentials here.
ONVO_SECRET_KEY=
ONVO_PUBLISHABLE_KEY=
ONVO_PRICE_ID=
ONVO_WEBHOOK_SECRET=
ONVO_SUBSCRIPTION_WEBHOOK_SIGNING_SECRET=
ONVO_SUBSCRIPTION_WEBHOOK_ACCOUNT_ID=

# Bonfire Factura STAG. Leave off until the test project and rule are approved.
BONFIRE_FACTURA_ENABLED=false
BONFIRE_FACTURA_WORKER_ENABLED=false
BONFIRE_FACTURA_WORKER_TOKEN=
BONFIRE_FACTURA_STAG_URL=
BONFIRE_FACTURA_STAG_PROJECT_ID=
BONFIRE_FACTURA_STAG_KEY=
BONFIRE_FACTURA_STAG_SECRET=
BONFIRE_FACTURA_PRO_ONVO_PRICE_ID=
BONFIRE_FACTURA_PRO_CABYS=
BONFIRE_FACTURA_PRO_NET_PRICE=
BONFIRE_FACTURA_PRO_CURRENCY=
BONFIRE_FACTURA_PRO_PAYMENT_METHOD=

# Optional: base64 of an already-trusted public corporate CA, local ONVO test only.
# ONVO_TEST_CA_CERT_BASE64=

BILLING_ALLOWED_ORIGINS=http://localhost:4300,http://127.0.0.1:4300,http://localhost:4200,http://127.0.0.1:4200
